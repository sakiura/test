{
  "expo": {
    "name": "ぬりつぶし日本",
    "slug": "nuritsubushi-nihon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.nuritsubushi",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "広告をより関連性の高いものにするために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "訪れた市区町村を地図に塗るために現在地を使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "訪れた場所の写真を記録に残すために使用します。",
          "cameraPermission": "訪れた場所の写真を撮って記録に残すために使用します。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}